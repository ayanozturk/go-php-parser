# Benchmark/compat-metrics corpora are fetched on demand by
# `go run ./cmd/fetch-test-projects` per test_projects/manifest.json; the
# checked-out sources themselves are large (hundreds of MB each) and are
# not committed. Do not add exceptions here for individual corpus
# directories without also adding a .gitmodules entry or gitlinks will
# silently resolve to empty directories on a fresh clone.
/test_projects/*
!/test_projects/manifest.json

# Benchmark JSON is generated evidence. Keep durable conclusions in Markdown
# and publish raw reports as CI/run artifacts rather than committing them.
/docs/benchmarks/*wordpress*.json
php-parser
